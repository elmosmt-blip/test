# Скопируй в .env и заполни (или экспортируй переменные напрямую в shell)

# ─── Открытая LLM (любой OpenAI-совместимый сервер) ───
# Ollama (по умолчанию):
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# vLLM:
# LLM_API_BASE=http://localhost:8000/v1
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# llama.cpp server:
# LLM_API_BASE=http://localhost:8080/v1

# LM Studio:
# LLM_API_BASE=http://localhost:1234/v1

# OpenRouter (открытые модели в облаке, нужен ключ):
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=meta-llama/llama-3.1-70b-instruct

LLM_TIMEOUT=180
LLM_MAX_RETRIES=3

# Для локальной smoke-проверки без внешней LLM можно включить mock.
# В production обязательно 0. (MOCK_LLM — устаревший алиас, тоже работает.)
LLM_MOCK=0
# MOCK_LLM=0

# Кэш ответов LLM (cache/llm_responses.json, TTL 24ч). Выключи для отладки
# промптов, если не хочешь получать закэшированный старый ответ.
LLM_CACHE_ENABLED=1

# ─── База данных (Neon Postgres) ───
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Защита от случайной записи/approve/delete. Для реальной публикации/черновиков поставь 1.
ALLOW_DB_WRITES=0

# ─── Fresh news collection ───
# Агент #1 ищет только свежие новости за последние N дней.
NEWS_LOOKBACK_DAYS=30
NEWS_STRICT_FRESH=1
NEWS_VERIFY_DATES=1
NEWS_TIMEZONE=Asia/Jerusalem
NEWS_MAX_RESULTS=5
NEWS_RSS_MAX_ITEMS=20
NEWS_HTML_MAX_ITEMS=50
# Сколько тем агент #1 отберёт за один scan (run-all.sh пишет по 1 статье на каждую).
NEWS_MAX_TOPICS=5
# Можно переопределить RSS-источники: Name|URL;Name|URL
# NEWS_RSS_FEEDS=SMT Today|https://smttoday.com/feed/;EMSNow|https://www.emsnow.com/feed/

# Источник правды для источников — YAML-реестр sources/ (см. docs/SOURCE_REGISTRY.md).
# 1 = принудительно использовать старые захардкоженные списки вместо sources/
# (safety net на случай проблем с реестром; обычно не нужно трогать).
NEWS_DISABLE_REGISTRY=0

# Google News RSS как доп. канал поиска (устойчивее DuckDuckGo к блокировкам).
NEWS_GOOGLE_RSS_ENABLED=1

# Извлекать полный текст статьи (не только сниппет) для топ-N ранжированных
# сигналов — даёт Writer'у реальные факты вместо пересказа заголовка.
NEWS_FULLTEXT_ENABLED=1
NEWS_FULLTEXT_TOP_N=20

# Минимум источников на тему. Если после сбора у темы меньше — агент #1
# запускает точечный доп-поиск именно по этой теме (не общий скан).
NEWS_MIN_SOURCES_PER_TOPIC=2
NEWS_TOPIC_SUPPLEMENTARY_SEARCH=1

# Dashboard
PORT=8800

# ─── Vendor/manufacturer sources ───
NEWS_VENDOR_SOURCES_ENABLED=1
NEWS_VENDOR_VERIFY_PAGES=0
NEWS_VENDOR_MAX_LINKS=8
NEWS_VENDOR_MAX_ITEMS=2
NEWS_TOPIC_MAX_SOURCES=5
NEWS_DEDUPE_EXISTING=1
ALLOW_DUPLICATE_PUBLICATIONS=0
# Optional override: Name|URL|group;Name2|URL2|group
# NEWS_VENDOR_SOURCES=Koh Young|https://kohyoungamerica.com/news/|inspection;Yamaha SMT|https://global.yamaha-motor.com/business/smt/news/|placement

# ─── Writer (agent-02) ───
# Порог self-review: пропустить второй проход (черновик без ревизии, быстрее,
# но ниже качество). То же самое, что флаг --no-revision.
WRITER_SKIP_REVISION=0
# Точечный третий проход — чинит ТОЛЬКО то, что нашёл детерминированный
# линтер (agents/article_linter.py) после self-review. 0 — отключить.
WRITER_LINT_REPAIR=1

# ─── Quality Checker (agent-02b) ───
# Минимальный score (0-100) для авто-одобрения без переписывания.
QUALITY_THRESHOLD=75
